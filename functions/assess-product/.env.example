# AI Provider Environment Variables
# Copy this to .env and fill in your values

# ─── AI Configuration ────────────────────────────────────────────
# Supported providers: gemini, openai, claude
AI_PROVIDER=gemini

# Your API key for the selected provider
# - Gemini: Get from https://aistudio.google.com/apikey
# - OpenAI: Get from https://platform.openai.com/api-keys
# - Claude: Get from https://console.anthropic.com/
AI_API_KEY=your_api_key_here

# Optional: Override the default model
# - Gemini: gemini-2.0-flash (default), gemini-2.0-pro
# - OpenAI: gpt-4o, gpt-4o-mini
# - Claude: claude-sonnet-4-20250514
# AI_MODEL=gemini-2.0-flash

# ─── Appwrite (auto-injected by Appwrite runtime) ───────────────
# These are automatically available in Appwrite Functions:
# APPWRITE_FUNCTION_API_ENDPOINT
# APPWRITE_FUNCTION_PROJECT_ID
